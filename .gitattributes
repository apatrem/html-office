# The reproducible assessment hashes its text inputs byte for byte.
tools/engine-assessment/** text eol=lf

# Data executable and notice digests must survive cross-platform checkout.
packages/data/** text eol=lf
packages/data/engine/vendor/*.wasm binary
packages/data/engine/vendor/*.wasm.gz binary
# T21 acceptance samples and CSV sources are published byte for byte (CRLF
# CSV, binary PDF); their digests are recorded in the workbook.
packages/data/acceptance/sources/*.csv -text
packages/data/acceptance/output/*.csv -text
packages/data/acceptance/output/*.pdf binary
packages/data/acceptance/output/*.html -text
