{
  "family": "lookup-text-number",
  "provenance": {
    "method": "Independent small hand-derived fixtures, not measured in Excel and never copied from engine output. Definitions/examples from the linked primary Microsoft function documentation; English formula/number locale.",
    "sources": [
      "https://support.microsoft.com/en-us/excel/excel-functions-alphabetical",
      "https://support.microsoft.com/en-us/excel/functions/xlookup-function",
      "https://support.microsoft.com/en-us/excel/functions/index-function",
      "https://support.microsoft.com/en-us/excel/functions/match-function",
      "https://support.microsoft.com/en-us/excel/functions/round-function",
      "https://support.microsoft.com/en-us/excel/functions/text-function",
      "https://support.microsoft.com/en-us/excel/functions/textjoin-function",
      "https://support.microsoft.com/en-us/excel/functions/concatenate-function"
    ],
    "checked": "2026-10-20"
  },
  "inputs": {
    "A1": {
      "input": {
        "type": "number",
        "value": 10
      }
    },
    "A2": {
      "input": {
        "type": "number",
        "value": 20
      }
    },
    "A3": {
      "input": {
        "type": "number",
        "value": 30
      }
    },
    "B1": {
      "input": {
        "type": "text",
        "value": "ten"
      }
    },
    "B2": {
      "input": {
        "type": "text",
        "value": "twenty"
      }
    },
    "B3": {
      "input": {
        "type": "text",
        "value": "thirty"
      }
    },
    "C1": {
      "input": {
        "type": "number",
        "value": 30
      }
    },
    "C2": {
      "input": {
        "type": "number",
        "value": 20
      }
    },
    "C3": {
      "input": {
        "type": "number",
        "value": 10
      }
    },
    "D1": {
      "input": {
        "type": "text",
        "value": "café"
      }
    },
    "A9": {
      "formula": "=1/0"
    }
  },
  "cases": [
    {
      "id": "xlookup-exact",
      "functions": [
        "XLOOKUP"
      ],
      "formula": "=XLOOKUP(20,A1:A3,B1:B3)",
      "expected": {
        "type": "text",
        "value": "twenty"
      },
      "afterRowInsertion": "=XLOOKUP(20,A2:A4,B2:B4)"
    },
    {
      "id": "xlookup-missing",
      "functions": [
        "XLOOKUP"
      ],
      "formula": "=XLOOKUP(99,A1:A3,B1:B3)",
      "expected": {
        "type": "error",
        "value": "#N/A"
      }
    },
    {
      "id": "xlookup-fallback",
      "functions": [
        "XLOOKUP"
      ],
      "formula": "=XLOOKUP(99,A1:A3,B1:B3,\"missing\")",
      "expected": {
        "type": "text",
        "value": "missing"
      }
    },
    {
      "id": "xlookup-next-smaller",
      "functions": [
        "XLOOKUP"
      ],
      "formula": "=XLOOKUP(25,A1:A3,B1:B3,, -1)",
      "expected": {
        "type": "text",
        "value": "twenty"
      }
    },
    {
      "id": "xlookup-wildcard",
      "functions": [
        "XLOOKUP"
      ],
      "formula": "=XLOOKUP(\"t*\",B1:B3,A1:A3,,2)",
      "expected": {
        "type": "number",
        "value": 10
      }
    },
    {
      "id": "xlookup-single-cell",
      "functions": [
        "XLOOKUP"
      ],
      "formula": "=XLOOKUP(10,A1,B1)",
      "expected": {
        "type": "text",
        "value": "ten"
      }
    },
    {
      "id": "index-table",
      "functions": [
        "INDEX"
      ],
      "formula": "=INDEX(A1:B3,2,2)",
      "expected": {
        "type": "text",
        "value": "twenty"
      }
    },
    {
      "id": "index-column",
      "functions": [
        "INDEX"
      ],
      "formula": "=INDEX(B1:B3,3)",
      "expected": {
        "type": "text",
        "value": "thirty"
      }
    },
    {
      "id": "index-out-of-bounds",
      "functions": [
        "INDEX"
      ],
      "formula": "=INDEX(A1:B3,4,1)",
      "expected": {
        "type": "error",
        "value": "#REF!"
      }
    },
    {
      "id": "match-exact",
      "functions": [
        "MATCH"
      ],
      "formula": "=MATCH(20,A1:A3,0)",
      "expected": {
        "type": "number",
        "value": 2
      }
    },
    {
      "id": "match-approximate",
      "functions": [
        "MATCH"
      ],
      "formula": "=MATCH(25,A1:A3,1)",
      "expected": {
        "type": "number",
        "value": 2
      }
    },
    {
      "id": "match-descending",
      "functions": [
        "MATCH"
      ],
      "formula": "=MATCH(25,C1:C3,-1)",
      "expected": {
        "type": "number",
        "value": 1
      }
    },
    {
      "id": "match-wildcard",
      "functions": [
        "MATCH"
      ],
      "formula": "=MATCH(\"t*\",B1:B3,0)",
      "expected": {
        "type": "number",
        "value": 1
      }
    },
    {
      "id": "match-missing",
      "functions": [
        "MATCH"
      ],
      "formula": "=MATCH(99,A1:A3,0)",
      "expected": {
        "type": "error",
        "value": "#N/A"
      }
    },
    {
      "id": "round-decimal",
      "functions": [
        "ROUND"
      ],
      "formula": "=ROUND(2.675,2)",
      "expected": {
        "type": "number",
        "value": 2.68
      }
    },
    {
      "id": "round-negative",
      "functions": [
        "ROUND"
      ],
      "formula": "=ROUND(-1.25,1)",
      "expected": {
        "type": "number",
        "value": -1.3
      }
    },
    {
      "id": "round-hundreds",
      "functions": [
        "ROUND"
      ],
      "formula": "=ROUND(1234,-2)",
      "expected": {
        "type": "number",
        "value": 1200
      }
    },
    {
      "id": "round-bad-value",
      "functions": [
        "ROUND"
      ],
      "formula": "=ROUND(\"text\",1)",
      "expected": {
        "type": "error",
        "value": "#VALUE!"
      }
    },
    {
      "id": "roundup-positive",
      "functions": [
        "ROUNDUP"
      ],
      "formula": "=ROUNDUP(1.21,1)",
      "expected": {
        "type": "number",
        "value": 1.3
      }
    },
    {
      "id": "roundup-negative",
      "functions": [
        "ROUNDUP"
      ],
      "formula": "=ROUNDUP(-1.21,1)",
      "expected": {
        "type": "number",
        "value": -1.3
      }
    },
    {
      "id": "roundup-reference",
      "functions": [
        "ROUNDUP"
      ],
      "formula": "=ROUNDUP(A1,-2)",
      "expected": {
        "type": "number",
        "value": 100
      }
    },
    {
      "id": "roundup-error",
      "functions": [
        "ROUNDUP"
      ],
      "formula": "=ROUNDUP(A9,1)",
      "expected": {
        "type": "error",
        "value": "#DIV/0!"
      }
    },
    {
      "id": "rounddown-positive",
      "functions": [
        "ROUNDDOWN"
      ],
      "formula": "=ROUNDDOWN(1.29,1)",
      "expected": {
        "type": "number",
        "value": 1.2
      }
    },
    {
      "id": "rounddown-negative",
      "functions": [
        "ROUNDDOWN"
      ],
      "formula": "=ROUNDDOWN(-1.29,1)",
      "expected": {
        "type": "number",
        "value": -1.2
      }
    },
    {
      "id": "rounddown-reference",
      "functions": [
        "ROUNDDOWN"
      ],
      "formula": "=ROUNDDOWN(A1,-2)",
      "expected": {
        "type": "number",
        "value": 0
      }
    },
    {
      "id": "rounddown-error",
      "functions": [
        "ROUNDDOWN"
      ],
      "formula": "=ROUNDDOWN(A9,1)",
      "expected": {
        "type": "error",
        "value": "#DIV/0!"
      }
    },
