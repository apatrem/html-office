{
  "family": "date-statistics-finance",
  "provenance": {
    "method": "Independent hand-derived calendar/arithmetic/statistical cases, not captured from engine output. Apart from the explicit NPV error observations below, cases have not been run in Excel. Sample/population variance uses the n-1/n denominator; percentile ranks use 1+(n-1)k or (n+1)k; NPV discounts its first value at period1. Float tolerances are explicit per mathematically derived case. NPV error propagation was additionally observed in a fresh Microsoft Excel for Mac 16.114 workbook on 2026-10-20; both referenced =1/0 and direct 1/0 returned #DIV/0!, despite the generic support page saying reference errors are ignored.",
    "sources": [
      "https://support.microsoft.com/en-us/excel/excel-functions-alphabetical",
      "https://support.microsoft.com/en-us/excel/functions/date-function",
      "https://support.microsoft.com/en-us/excel/functions/edate-function",
      "https://support.microsoft.com/en-us/excel/functions/eomonth-function",
      "https://support.microsoft.com/en-us/excel/functions/median-function",
      "https://support.microsoft.com/en-us/excel/functions/percentile-inc-function",
      "https://support.microsoft.com/en-us/excel/functions/percentile-exc-function",
      "https://support.microsoft.com/en-us/excel/functions/stdev-s-function",
      "https://support.microsoft.com/en-us/excel/functions/npv-function",
      "https://learn.microsoft.com/en-us/openspecs/office_standards/ms-oi29500/989b9d25-033d-4717-b747-60218531c618"
    ],
    "checked": "2026-10-20",
