+        for (cell, value) in [("B1", "apple"), ("B2", "pear"), ("B3", "apple"), ("C1", "10"), ("C2", "20"), ("C3", "30"), ("E1", "=NA()"), ("E2", "apple")] { model._set(cell, value); }
+        model._set("H1", &format!("=SUMIF(B1:B3,{criteria},C1:C3)"));
+        model.evaluate();
+        assert_eq!(model._get_text("H1"), "#N/A", "{criteria}");
