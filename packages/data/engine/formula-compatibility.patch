+#[test]
+fn office_sumif_lifted_error_criteria() {
+    for criteria in ["E1:E2", "{#N/A;\"apple\"}"] {
+        let mut model = new_empty_model();
+        for (cell, value) in [("B1", "apple"), ("B2", "pear"), ("B3", "apple"), ("C1", "10"), ("C2", "20"), ("C3", "30"), ("E1", "=NA()"), ("E2", "apple")] { model._set(cell, value); }
+        model._set("H1", &format!("=SUMIF(B1:B3,{criteria},C1:C3)"));
+        model.evaluate();
+        assert_eq!(model._get_text("H1"), "#N/A", "{criteria}");
+        assert_eq!(model._get_text("H2"), "40", "{criteria}");
+    }
+}
+
+#[test]
+fn office_xlookup_single_cell_ranges() {
+    let mut model = new_empty_model();
+    model._set("A1", "10");
+    model._set("B1", "ten");
+    for (cell, formula) in [("H1", "=XLOOKUP(10,A1,B1)"), ("H2", "=XLOOKUP(10,A1:A1,B1)"), ("H3", "=XLOOKUP(10,A1,B1:B1)"), ("H4", "=XLOOKUP(20,A1,B1,\"missing\")")] { model._set(cell, formula); }
+    model.evaluate();
+    for cell in ["H1", "H2", "H3"] { assert_eq!(model._get_text(cell), "ten", "{cell}"); }
+    assert_eq!(model._get_text("H4"), "missing");
+}
