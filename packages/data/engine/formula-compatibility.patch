+#[test]
+fn office_textjoin_empty_strings() {
+    let mut model = new_empty_model();
+    model._set("B1", "ten");
+    model._set("B2", "=\"\"");
+    model._set("B3", "thirty");
+    let cases = [
+        ("=TEXTJOIN(\"|\",TRUE,B1:B3)", "ten|thirty"),
+        ("=TEXTJOIN(\"|\",FALSE,B1:B3)", "ten||thirty"),
+        ("=TEXTJOIN(\"|\",TRUE,B1,\"\",B3)", "ten|thirty"),
+        ("=TEXTJOIN(\"|\",FALSE,B1,\"\",B3)", "ten||thirty"),
+        ("=TEXTJOIN(\"|\",TRUE,B1,B2,B3)", "ten|thirty"),
+        ("=TEXTJOIN(\"|\",FALSE,B1,B2,B3)", "ten||thirty"),
+    ];
+    for (i, (formula, _)) in cases.iter().enumerate() { model._set(&format!("H{}", i + 1), formula); }
+    model.evaluate();
+    for (i, (_, expected)) in cases.iter().enumerate() { assert_eq!(model._get_text(&format!("H{}", i + 1)), *expected); }
+}
