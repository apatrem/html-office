+// Excel's plural criteria functions require identical rectangular shapes.
+fn same_shape(a: &Range, b: &Range) -> bool {
+    a.right.row - a.left.row == b.right.row - b.left.row
+        && a.right.column - a.left.column == b.right.column - b.left.column
+}
+
+// Single-criterion SUMIF/AVERAGEIF align from the sum/average range's top left.
+fn align_sum_range(mut sum: Range, criteria: &Range, cell: CellReferenceIndex) -> Result<Range, CalcResult> {
+    sum.right.row = sum.left.row + criteria.right.row - criteria.left.row;
+    sum.right.column = sum.left.column + criteria.right.column - criteria.left.column;
+    if sum.right.row > LAST_ROW || sum.right.column > LAST_COLUMN {
+        return Err(CalcResult::new_error(Error::REF, cell, "Aligned range exceeds worksheet bounds".to_string()));
+    }
+    Ok(sum)
+}
