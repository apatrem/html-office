+use crate::test::util::new_empty_model;
+
+#[test]
+fn halves_round_away_from_zero() {
+    let mut model = new_empty_model();
+    model._set("A1", "=TEXT(2.5,\"0\")");
+    model._set("A2", "=TEXT(-2.5,\"0\")");
+    model._set("A3", "=TEXT(0.125,\"0%\")");
+    model._set("A4", "=TEXT(-0.125,\"0%\")");
+    model._set("A5", "=TEXT(1234.5,\"#,##0\")");
+    model._set("A6", "=TEXT(-1234.5,\"#,##0\")");
+    model._set("A7", "=TEXT(0.125,\"0.00\")");
+    model._set("A8", "=TEXT(-0.125,\"0.00\")");
+    model._set("A9", "=TEXT(ROUND(2.5,0),\"0\")");
+    model.evaluate();
+
+    assert_eq!(model._get_text("A1"), *"3");
+    assert_eq!(model._get_text("A2"), *"-3");
+    assert_eq!(model._get_text("A3"), *"13%");
+    assert_eq!(model._get_text("A4"), *"-13%");
+    assert_eq!(model._get_text("A5"), *"1,235");
+    assert_eq!(model._get_text("A6"), *"-1,235");
+    assert_eq!(model._get_text("A7"), *"0.13");
+    assert_eq!(model._get_text("A8"), *"-0.13");
+    assert_eq!(model._get_text("A9"), *"3");
+}
