+/// Rounds to `decimals` places after the decimal point like Excel: the value is
+/// read at 15 significant digits and halves go away from zero (2.5 => 3, -2.5 => -3).
+fn round_half_away_from_zero(value: f64, decimals: i32) -> f64 {
+    let value = to_precision(value, 15);
+    let scale = 10.0_f64.powi(decimals);
+    to_precision(value * scale, 15).round() / scale
+}
