+#[test]
+fn test_halves_round_away_from_zero() {
+    let locale = get_default_locale();
+    // Exact binary halves, as Excel rounds them
+    assert_eq!(format_number(2.5, "0", locale).text, "3");
+    assert_eq!(format_number(-2.5, "0", locale).text, "-3");
+    assert_eq!(format_number(-0.5, "0", locale).text, "-1");
+    assert_eq!(format_number(-2.5, "0;(0)", locale).text, "(3)");
+    assert_eq!(format_number(0.125, "0%", locale).text, "13%");
+    assert_eq!(format_number(-0.125, "0%", locale).text, "-13%");
+    assert_eq!(format_number(1234.5, "#,##0", locale).text, "1,235");
+    assert_eq!(format_number(-1234.5, "#,##0", locale).text, "-1,235");
+    assert_eq!(format_number(0.125, "0.00", locale).text, "0.13");
+    assert_eq!(format_number(-0.125, "0.00", locale).text, "-0.13");
+    // Halves at 15 significant digits
+    assert_eq!(format_number(2.675, "0.00", locale).text, "2.68");
+    assert_eq!(format_number(1.005, "0.00", locale).text, "1.01");
+    // A rounded digit carries into the integer part
+    assert_eq!(format_number(0.999, "0.00", locale).text, "1.00");
+    assert_eq!(format_number(9.995, "0.00", locale).text, "10.00");
+    // Whole negative values keep their sign
+    assert_eq!(format_number(-1.0, "0", locale).text, "-1");
+    assert_eq!(format_number(-0.005, "0.00", locale).text, "-0.01");
+    assert_eq!(format_number(-0.001, "0.00", locale).text, "0.00");
+}
