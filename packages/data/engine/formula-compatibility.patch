+#[test]
+fn office_xlookup_single_cell_ranges() {
+    let mut model = new_empty_model();
+    model._set("A1", "10");
+    model._set("B1", "ten");
+    for (cell, formula) in [("H1", "=XLOOKUP(10,A1,B1)"), ("H2", "=XLOOKUP(10,A1:A1,B1)"), ("H3", "=XLOOKUP(10,A1,B1:B1)"), ("H4", "=XLOOKUP(20,A1,B1,\"missing\")")] { model._set(cell, formula); }
+    model.evaluate();
+    for cell in ["H1", "H2", "H3"] { assert_eq!(model._get_text(cell), "ten", "{cell}"); }
+    assert_eq!(model._get_text("H4"), "missing");
+}
