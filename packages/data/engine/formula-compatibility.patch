+#[test]
+fn office_criteria_shapes_errors_and_single_range_alignment() {
+    let mut model = new_empty_model();
+    for (cell, value) in [("B1", "apple"), ("B2", "pear"), ("B3", "apple"), ("C1", "10"), ("C2", "20"), ("C3", "30")] { model._set(cell, value); }
+    let cases = [
+        ("=SUMIFS(C1:C3,B1:B2,\"apple\")", "#VALUE!"),
+        ("=COUNTIFS(B1:B3,\"apple\",C1:C2,\">0\")", "#VALUE!"),
+        ("=AVERAGEIFS(C1:C3,B1:B2,\"apple\")", "#VALUE!"),
+        ("=SUMIF(B1:B3,NA(),C1:C3)", "#N/A"),
+        ("=COUNTIF(B1:B3,NA())", "#N/A"),
+        ("=AVERAGEIF(B1:B3,NA(),C1:C3)", "#N/A"),
+        ("=SUMIF(B1:B3,\"apple\",C1)", "40"),
+        ("=AVERAGEIF(B1:B3,\"apple\",C1)", "20"),
+        ("=AND(FALSE,1/0)", "#DIV/0!"),
+        ("=OR(TRUE,1/0)", "#DIV/0!"),
+    ];
+    for (i, (formula, _)) in cases.iter().enumerate() { model._set(&format!("H{}", i + 1), formula); }
+    model.evaluate();
+    for (i, (_, expected)) in cases.iter().enumerate() { assert_eq!(model._get_text(&format!("H{}", i + 1)), *expected); }
+}
